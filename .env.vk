# Сборка для ВКонтакте и Одноклассников (npm run build:vk): VK Bridge вместо SDK Яндекса (src/platform/target.ts),
# без звука — на хостинге ВК аудиофайлы запрещены (vite.config.ts их не кладёт в сборку)
VITE_TARGET=vk
# Сообщество игры — ссылка «Поддержка» в главном меню (единственная внешняя ссылка, которую разрешает ВК)
VITE_SUPPORT_URL=https://vk.com/nasha.rybalka
